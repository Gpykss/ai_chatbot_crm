# Copy this file to .env.local and fill it in.
# Without a key the app still runs, using sample AI replies.

# Get it from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model per language. Check exact model IDs on openrouter.ai/models.
MODEL_DEFAULT=sao10k/l3.3-euryale-70b
MODEL_EN=sao10k/l3.3-euryale-70b
MODEL_IT=
MODEL_FI=
MODEL_EL=

# Backup models, comma separated. Used automatically when the main model is busy.
MODEL_FALLBACKS=

# Price per million tokens, used for the cost shown in the dashboard.
PRICE_IN=0.65
PRICE_OUT=0.75
